#!/usr/bin/env bash
# Test suite for the sre-discipline skill content. Plain bash; no network,
# no Docker, no external dependencies.
#
# 1. Every fenced ```bash block in the skill markdown parses as shell after
#    <placeholder> normalization (the docs embed runnable commands; an
#    unparseable snippet is a defect).
# 2. Every reference doc cited by SKILL.md or README.md exists, and every
#    reference file on disk is cited somewhere.
# 3. The scheduled-jobs.md fail-closed window guard runs its own preconditions:
#    it must permit the window interior and refuse everything outside it,
#    including windows that cross midnight.
# 4. The migrations.md env-drift comparisons actually run and are quiet for a
#    healthy container (daemon-injected vars excluded) and loud for real drift.
set -u
cd "$(dirname "$0")/.."

failures=0

report() { # $1 = label, $2 = ok(0/1), rest = detail
  if [ "$2" -ne 0 ]; then
    failures=$((failures + 1))
    printf 'FAIL %s%s\n' "$1" "${3:+: $3}"
  fi
}

# --- 1. bash syntax of every fenced bash block -------------------------------
while IFS= read -r -d '' md; do
  in_block=0
  block=""
  lineno=0
  block_start=0
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    case "$line" in
      '```bash'*'```'*) continue ;;          # inline fence, not a block
      '```bash'*)
        in_block=1; block=""; block_start=$lineno; continue ;;
      '```'*)
        if [ "$in_block" = 1 ]; then
          printf '%s' "$block" \
            | sed -E -e 's/<[^<> ]*>/PLACEHOLDER/g' -e 's/\$\$\{!\}/\$\{PLACEHOLDER\}/g' \
            | bash -n > /tmp/sre-test-bashn.$$ 2>&1
          report "$md bash block at line $block_start" $? \
            "$(tr '\n' ' ' < /tmp/sre-test-bashn.$$ | head -c 160; rm -f /tmp/sre-test-bashn.$$)"
        fi
        in_block=0; continue ;;
    esac
    if [ "$in_block" = 1 ]; then block+="$line"$'\n'; fi
  done < "$md"
done < <(find skills -name '*.md' -type f -print0 | sort -z)

# --- 2. reference-doc linkage -------------------------------------------------
for ref in $(grep -ho 'references/[a-z-]*\.md' skills/sre/SKILL.md README.md | sort -u); do
  [ -f "skills/sre/$ref" ] || { report "cited reference exists: $ref" 1; continue; }
done
for f in skills/sre/references/*.md; do
  name=$(basename "$f")
  grep -q "$name" skills/sre/SKILL.md README.md || \
    report "reference file is cited: $name" 1
done

# --- 3. the window guard in scheduled-jobs.md --------------------------------
GUARD=skills/sre/references/scheduled-jobs.md
snippet=$(awk '
  /# In the job itself, not only in the timer/ {b=1; next}
  b && /^```[[:space:]]*$/ {exit}
  b {print}
' "$GUARD")
case "$snippet" in
  *'in_window'*) ;; *) report "window guard snippet found in $GUARD" 1 ;;
esac

run_guard() { # $1=REBOOT_TIME $2=WINDOW_MINUTES $3=fixed now ; prints ALLOWED|REFUSED
  local out
  out=$(printf '%s' "$snippet" | sed "s/^now=.*/now=$3/" | \
        REBOOT_TIME=$1 WINDOW_MINUTES=$2 bash 2>/dev/null) || true
  case "$out" in *refusing*) echo REFUSED ;; *) echo ALLOWED ;; esac
}

while read -r rt wm now want desc; do
  [ -n "${rt:-}" ] || continue
  got=$(run_guard "$rt" "$wm" "$now")
  [ "$got" = "$want" ] || report "window guard $rt + $wm min at $now UTC ($desc)" 1 \
    "got $got, want $want"
done <<CASES
05:00 30 0510 ALLOWED same-day interior
05:00 30 0440 REFUSED same-day before window
05:00 30 0530 ALLOWED same-day inclusive end
05:00 30 0531 REFUSED same-day just past end
23:00 120 2330 ALLOWED crossing-midnight evening side
23:00 120 0030 ALLOWED crossing-midnight morning side
23:00 120 0100 ALLOWED crossing-midnight inclusive end
23:00 120 0130 REFUSED crossing-midnight just past end
23:00 120 1200 REFUSED crossing-midnight midday
22:00 240 0159 ALLOWED crossing-midnight before seam
22:00 240 0200 ALLOWED crossing-midnight at end
22:00 240 0201 REFUSED crossing-midnight past end
00:30 45 0045 ALLOWED same-day window anchored after midnight
CASES

# --- 4. env-drift snippets in migrations.md ----------------------------------
MIG=skills/sre/references/migrations.md
ENVSCRATCH=/tmp/sre-test-env.$$
mkdir -p "$ENVSCRATCH"

envsnippet=$(awk '
  /^# Env var presence in running containers/ {b=1; next}
  b && /^```[[:space:]]*$/ {exit}
  b {print}
' "$MIG")
case "$envsnippet" in
  *'{{range .Config.Env}}'*) ;; *) report "env-drift snippet found in $MIG" 1 ;;
esac

# Stub docker(1): the running env is what RUNNING_VARS holds, one VAR=VAL
# per line, which is what the range rendering of .Config.Env produces.
{ printf '%s\n' "docker() { for v in \$RUNNING_VARS; do printf '%s\n' \"\$v\"; done; }" > "$ENVSCRATCH/stub.sh"; }

run_env_snippet() { # $1 = running env lines, $2 = persistent .env lines; prints snippet stdout
  local body running_flat
  printf '%s\n' "$2" > "$ENVSCRATCH/persistent.env"
  running_flat=$(printf '%s' "$1" | tr '\n' ' ')
  body=$(printf '%s' "$envsnippet" \
    | sed -e 's|docker inspect <name>|docker inspect web1|' \
          -e "s|/etc/<service>/.env|$ENVSCRATCH/persistent.env|" \
          -e "s|/tmp/running-env|$ENVSCRATCH/running.out|" \
          -e "s|/tmp/persistent-env|$ENVSCRATCH/persistent.out|")
  { cat "$ENVSCRATCH/stub.sh"
    # Quote the value: an unquoted multi-var value would be parsed as
    # several assignments (RUNNING_VARS=A B=2 C=3), clobbering PATH.
    printf "RUNNING_VARS='%s'\n" "$running_flat"
    printf '%s\n' "$body"
  } | bash 2>/dev/null
}

out=$(run_env_snippet 'API_KEY=abc
DB_HOST=db.prod.internal
DB_PORT=5432
PATH=/usr/local/bin:/usr/bin
HOSTNAME=web1' 'API_KEY=abc
DB_HOST=db.prod.internal
DB_PORT=5432')
[ -z "$out" ] || report "env snippet: zero-drift env reads clean" 1 "got: $out"

out=$(run_env_snippet 'DB_HOST=db.prod.internal
DB_PORT=5432' 'API_KEY=abc
DB_HOST=db.prod.internal
DB_PORT=5432')
[ "$out" = "API_KEY=abc" ] || report "env snippet: missing var reported" 1 "got: $out"

loopsnippet=$(awk '
  /^# Check every container/ {b=1; next}
  b && /^```[[:space:]]*$/ {exit}
  b {print}
' "$MIG")
case "$loopsnippet" in
  *'comm -23'*) ;; *) report "env-drift loop snippet found in $MIG" 1 ;;
esac

{ printf '%s\n' 'docker() {'
  printf '%s\n' '  case "$1" in'
  printf '%s\n' '    ps) echo web1 ;;'
  printf '%s\n' '    inspect) for v in $RUNNING_VARS; do printf "%s\n" "$v"; done ;;'
  printf '%s\n' '  esac'
  printf '%s\n' '}'
} > "$ENVSCRATCH/stub2.sh"

run_env_loop() { # $1 = running env lines, $2 = path to the stub .env file; prints snippet stdout
  local body
  body=$(printf '%s' "$loopsnippet" | sed -e "s|/home/<user>/\$c/.env|$2|")
  { cat "$ENVSCRATCH/stub2.sh"
    printf "RUNNING_VARS='%s'\n" "$(printf '%s' "$1" | tr '\n' ' ')"
    printf '%s\n' "$body"
  } | bash 2>/dev/null
}

printf 'API_KEY=abc\nDB_HOST=db.prod.internal\nDB_PORT=5432\n' > "$ENVSCRATCH/web1.env"
out=$(run_env_loop 'API_KEY=abc
DB_HOST=db.prod.internal
DB_PORT=5432
PATH=/usr/local/bin:/usr/bin' "$ENVSCRATCH/web1.env")
case "$out" in *"web1: OK"*) ;; *) report "env loop: zero-drift env reads clean" 1 "got: $out" ;; esac

out=$(run_env_loop 'DB_HOST=db.prod.internal
DB_PORT=5432
PATH=/usr/local/bin:/usr/bin' "$ENVSCRATCH/web1.env")
case "$out" in *"web1: DRIFT: API_KEY=abc"*) ;; *) report "env loop: missing var reported" 1 "got: $out" ;; esac

out=$(run_env_loop 'DB_HOST=db.prod.internal' "$ENVSCRATCH/absent.env")
case "$out" in *"web1: DRIFT: env file missing"*) ;; *) report "env loop: missing env file reported" 1 "got: $out" ;; esac

rm -rf "$ENVSCRATCH"

if [ "$failures" -eq 0 ]; then
  echo "test: ok"
  exit 0
fi
echo "test: $failures failure(s)"
exit 1
